# Exchange (via ccxt) credentials.
# Create the key with SPOT TRADE permission only — never enable withdrawals.
EXCHANGE_ID=binance
API_KEY=
API_SECRET=

# Use the exchange's sandbox/testnet instead of real funds.
USE_TESTNET=true

# If true, no real orders are sent — trades are only simulated and logged.
# Keep this true until you've validated the strategy in backtest + testnet.
DRY_RUN=true

# Market to trade and candle timeframe.
SYMBOL=BTC/USDT
TIMEFRAME=15m

# Amount in quote currency (e.g. USDT) spent per buy order.
TRADE_AMOUNT_QUOTE=50

# Strategy parameters.
SMA_SHORT=9
SMA_LONG=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_BUY_MAX=60

# Risk management.
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.05

# How often the bot checks the market, in seconds.
POLL_INTERVAL_SECONDS=60

# Optional Telegram notifications. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Paper trading bot (paper_main.py) ---
# Fully simulated buy/hold/sell using real market prices. No real orders are
# ever sent by this bot, regardless of PAPER_TRADING - the flag only gates
# paper_main.py's startup as an extra safety check.
PAPER_TRADING=true

# Starting simulated cash balance, in quote currency (e.g. BRL or USDT).
INITIAL_CAPITAL=3000

# Percent of the current available balance spent on each buy.
TRADE_PERCENT=30

# Minimum net profit (%) required, after both fees, before selling.
MIN_PROFIT_PERCENT=0.5

# Simulated exchange fees (%) applied on buy and sell.
BUY_FEE_PERCENT=0.1
SELL_FEE_PERCENT=0.1
