# Exchange (via ccxt) credentials.
# Create the key with SPOT TRADE permission only — never enable withdrawals.
EXCHANGE_ID=binance
API_KEY=
API_SECRET=

# Use the exchange's sandbox/testnet instead of real funds.
USE_TESTNET=true

# If true, no real orders are sent — trades are only simulated and logged.
# Keep this true until you've validated the strategy in backtest + testnet.
DRY_RUN=true

# Market to trade and candle timeframe.
SYMBOL=BTC/USDT
TIMEFRAME=15m

# Amount in quote currency (e.g. USDT) spent per buy order.
TRADE_AMOUNT_QUOTE=50

# Strategy parameters.
SMA_SHORT=9
SMA_LONG=21
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_BUY_MAX=60

# Risk management.
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.05

# How often the bot checks the market, in seconds.
POLL_INTERVAL_SECONDS=60

# Optional Telegram notifications. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
